#include "main.h"

#define IMU_ADDR      (0x6B << 1)   /* LSM6DSL I2C address               */
#define WHO_AM_I      0x0F          /* should read 0x6A                  */
#define CTRL1_XL      0x10          /* accelerometer settings register   */
#define OUTX_L_XL     0x28          /* first accelerometer data register */
#define LSB_PER_G     2049          /* +-16 g range: 0.488 mg per LSB    */
#define JOLT_G        2             /* event threshold in g              */

I2C_HandleTypeDef hi2c1;

void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_I2C1_Init(void);

int main(void)
{
  HAL_Init();
  SystemClock_Config();
  MX_GPIO_Init();
  MX_I2C1_Init();
  HAL_Delay(50);

  /* 1. Check the IMU is there */
  uint8_t who = 0;
  HAL_I2C_Mem_Read(&hi2c1, IMU_ADDR, WHO_AM_I, I2C_MEMADD_SIZE_8BIT, &who, 1, 100);
  if (who != 0x6A)
  {
    /* IMU not found: fast flicker forever */
    while (1)
    {
      HAL_GPIO_TogglePin(GPIOB, GPIO_PIN_3);
      HAL_Delay(100);
    }
  }

  /* 2. Turn the accelerometer on: 208 Hz, +-16 g */
  uint8_t cfg = 0x54;
  HAL_I2C_Mem_Write(&hi2c1, IMU_ADDR, CTRL1_XL, I2C_MEMADD_SIZE_8BIT, &cfg, 1, 100);
  HAL_Delay(20);

  /* 3 quick blinks = IMU found and running */
  for (int i = 0; i < 6; i++)
  {
    HAL_GPIO_TogglePin(GPIOB, GPIO_PIN_3);
    HAL_Delay(150);
  }
  HAL_GPIO_WritePin(GPIOB, GPIO_PIN_3, GPIO_PIN_RESET);

  /* 3. Read acceleration forever and watch for a jolt */
  int64_t limit = (int64_t)(JOLT_G * LSB_PER_G) * (JOLT_G * LSB_PER_G);

  while (1)
  {
    uint8_t d[6];
    if (HAL_I2C_Mem_Read(&hi2c1, IMU_ADDR, OUTX_L_XL, I2C_MEMADD_SIZE_8BIT, d, 6, 50) == HAL_OK)
    {
      int16_t ax = (int16_t)(d[1] << 8 | d[0]);
      int16_t ay = (int16_t)(d[3] << 8 | d[2]);
      int16_t az = (int16_t)(d[5] << 8 | d[4]);

      int64_t mag2 = (int64_t)ax * ax + (int64_t)ay * ay + (int64_t)az * az;

      if (mag2 > limit)
      {
        /* JOLT DETECTED: LED on for 1 second */
        HAL_GPIO_WritePin(GPIOB, GPIO_PIN_3, GPIO_PIN_SET);
        HAL_Delay(1000);
        HAL_GPIO_WritePin(GPIOB, GPIO_PIN_3, GPIO_PIN_RESET);
      }
    }
    HAL_Delay(5);   /* about 200 readings per second */
  }
}

